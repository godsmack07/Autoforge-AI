FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5001

# Model Storage
MODEL_STORAGE_PATH=./models
DATA_STORAGE_PATH=./data

# ML Configuration
DEFAULT_TEST_SIZE=0.15
