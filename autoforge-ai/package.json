{
  "name": "autoforge-ai",
  "version": "1.0.0",
  "description": "AutoForge AI - No-code AutoML Platform",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:ml\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "start:ml": "cd ml-engine && python app.py",
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:ml",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:ml": "cd ml-engine && pip install -r requirements.txt",
    "test": "npm run test:backend && npm run test:ml",
    "test:backend": "cd backend && npm test",
    "test:ml": "cd ml-engine && pytest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "automl",
    "machine-learning",
    "no-code",
    "ai",
    "react",
    "express",
    "flask"
  ],
  "author": "AutoForge AI Team",
  "license": "MIT"
}
